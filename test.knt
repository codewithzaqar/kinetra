// Kinetra v0.0.1a14 test

let gravity = vec3(0.0, 0.0 - 9.8, 0.0);

let p = particle(vec3(0.0, 10.0, 0.0), vec3(1.0, 0.0, 0.0), 2.0);

print p.position;
print p.mass;

sim 3 dt 0.5 {
	p = apply_force(p, gravity * p.mass);
	p = integrate(p, dt);
	print p.position;
}

print p.velocity;

let v = vec3(3.0, 4.0, 0.0);
print v.x;
print v.y;