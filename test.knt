// Kinetra v0.0.1a08 test

print sqrt(16.0);
print abs(0.0 - 5.0);
print min(3.0, 7.0);
print max(3.0, 7.0);
print sin(0.0);
print cos(0.0);

let angle = 0.0;

sim 4 dt 0.25 {
	angle = angle + dt;
	print cos(angle);
}

let p = vec3(0.0, 0.0, 0.0);

sim 2 {
	p = p + vec3(1.0, 0.0, 0.0) * dt;
}

print p;