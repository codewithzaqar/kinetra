// Kinetra v0.0.1a11 test

fn square(x) {
	return x * x;
}

fn add(a, b) {
	return a + b;
}

fn sum_to(n) {
	let total = 0.0;
	let i = 0.0;

	while i < n {
		i = i + 1.0;
		total = total + i;
	}

	return total;
}

fn hypotenuse(a, b) {
	return sqrt(add(square(a), square(b)));
}

fn fib(n) {
	if n < 2.0 {
		return n;
	}

	return fib(n - 1.0) + fib(n - 2.0);
}

fn classify(x) {
	if x < 0.0 {
		return 0.0 - 1.0;
	}

	return 1.0;
}

let scale = 2.0;

fn scaled(v) {
	let scale = 3.0;
	return v * scale;
}

print square(4.0);
print add(2.0, 3.0);
print sum_to(10.0);
print hypotenuse(3.0, 4.0);
print fib(10.0);
print classify(0.0 - 7.0);
print classify(7.0);
print scaled(5.0);
print scale;